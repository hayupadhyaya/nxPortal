diff --git a/dm/host/stream.h b/dm/host/stream.h
new file mode 100644
index 0000000000000000000000000000000000000000..9aa600c515cfb23315f51a8ad8cdeebf2005fbce
--- /dev/null
+++ b/dm/host/stream.h
@@ -0,0 +1,43 @@
+// DM_STREAM: the game runs with no window and each present is drawn into an IOSurface and encoded as HEVC for a streaming front end (stream_video_mac.m; nvn_mtl.m stream_present).
+// Mac only. The encoder is HEVC Main, low-latency rate control, no frame reordering, long-term references; key frames only at the start, on request, on a size change and for a
+// refresh with no frame acknowledged since the last key frame
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdatomic.h>
+static inline int stream_on(void) { static _Atomic int on = -1; int v = atomic_load(&on); if (v < 0) { v = getenv("DM_STREAM") != NULL; atomic_store(&on, v); } return v; }   // read once, from any thread; here so either file links without the other
+void stream_video_config(int max_w, int max_h, int max_fps, int bitrate);   // any thread; the picture is scaled down to fit max_w x max_h, frames above max_fps dropped
+void stream_video_keyframe(void);   // the next frame is a key frame
+void stream_video_ltr_ack(const int32_t *tokens, int n);   // the front end decoded the frames that carried these tokens (the video message's token)
+void stream_video_refresh(void);   // the front end lost a frame: the next frame depends on nothing it may not have
+enum { STREAM_FAULT_ENCODE = 1, STREAM_FAULT_NO_LTR = 2 };   // for the test: the next encode fails as a refused VTCompressionSessionEncodeFrame; sessions made from now on run as if EnableLTR were refused
+void stream_video_fault(int faults);
+// An IOSurfaceRef (BGRA8, not retained for the caller) of the picture scaled down to the configured maximum (aspect kept, even dimensions, never up), or NULL: no config yet, the
+// frame-rate cap says skip, or all 3 slots are in flight. A NULL frame is dropped, never waited for. The slot is the caller's until stream_video_submit or stream_video_abort
+void *stream_video_surface(int pic_w, int pic_h, int *slot);
+void stream_video_submit(int slot, uint64_t capture_ns);   // the slot's GPU work is done: encode it (capture_ns: CLOCK_UPTIME_RAW)
+void stream_video_abort(int slot);   // the slot's GPU work failed: free it
+// flags: 0, STREAM_FRAME_KEY or STREAM_FRAME_REPAIR. data: 4-byte big-endian length-prefixed NAL units; a key frame starts with VPS, SPS, PPS. token: the frame's long-term reference token as sent ((session epoch << 24) | the encoder's token, opaque to the front end), -1 for none. Called on the encoder's thread
+#define STREAM_FRAME_KEY 1      // flags bit 0: a key frame
+#define STREAM_FRAME_REPAIR 2   // flags bit 1: a frame encoded with ForceLTRRefresh that came out as a non-key frame; never set with STREAM_FRAME_KEY (the value 3 is never sent)
+typedef void (*stream_frame_cb)(const uint8_t *data, size_t n, int flags, int32_t token, int w, int h, uint64_t capture_ns);
+void stream_video_set_sink(stream_frame_cb cb);
+
+// The tap socket (stream_mac.c). A layout change of any message bumps this on both sides (nxPortal CHANGELOG-protocol.md)
+#define STREAM_TAP_VERSION 2
+int stream_start(const char *title_id, const char *name);   // connects to the DM_STREAM path, sends the hello, starts the reader thread; 0 ok
+// One 5 ms block (240 frames) from one silent sink; the sources are mixed into one stereo stream, one audio message per push of the clock source (the first to push).
+// ch channels as the sink holds them; has_fold: the last two are the sink's pre-clamped stereo fold. source: any pointer that tells the sinks apart
+void stream_audio_pcm(const void *pcm16, size_t bytes, int ch, int has_fold, const void *source);
+void stream_audio_pcm_at(const void *pcm16, size_t bytes, int ch, int has_fold, const void *source, uint64_t now);   // stream_audio_pcm with the time given (CLOCK_UPTIME_RAW ns): for the test
+extern void (*stream_quit_hook)(void);   // called once when the stream ends (quit, closed socket, bad message); default: a graceful exit through SIGTERM. Tests replace it
+// The prepare step before the first frame (nvn_mtl.m warm_start: the prewarm lists' pipelines, then the shader pairs' prebuild), told to the Host in prepare messages. Between begin
+// and end no video or audio message is sent (a frame encoded meanwhile is dropped and the next one is a key frame). stream_prepare: sent when a phase starts, at most every 250 ms
+// while it runs, and once with done == total when it ends; a call that sends nothing returns at once. stream_prepare_at: the same with the time given (CLOCK_UPTIME_RAW ns): for the test
+enum { STREAM_PREPARE_LISTS = 1, STREAM_PREPARE_PAIRS = 2 };
+int stream_prepare_wanted(void);   // connected to the Host and DM_STREAM_PREPARE is not 0: the game prepares before its first frame (else in the background while playing)
+void stream_prepare_begin(void);
+void stream_prepare(int phase, long done, long total);
+void stream_prepare_at(int phase, long done, long total, uint64_t now);
+void stream_prepare_end(void);
diff --git a/dm/host/stream_mac.c b/dm/host/stream_mac.c
new file mode 100644
index 0000000000000000000000000000000000000000..755ad9d80dd5c7dcc4d520ecd8a0dba91a44c52f
--- /dev/null
+++ b/dm/host/stream_mac.c
@@ -0,0 +1,227 @@
+// DM_STREAM tap socket (Mac only): the host connects to the streaming front end's Unix socket, sends the encoded video (stream_video_mac.m) and the game's sound, and takes the controllers,
+// pause and quit from it. Messages: u32 little-endian length of (type + payload), u8 type, payload; every integer little-endian, fields packed (docs/frontends.md, Streaming front ends).
+// One reader thread; writes are whole messages under one lock (the encoder's thread and the sound threads both write). Anything that ends the stream calls stream_quit_hook once
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+#include "dm.h"
+#include "dm_input.h"
+#include "stream.h"
+
+void dm_background(int on);   // hle.h: the background sequence and its reverse
+
+enum { T_HELLO = 1, T_VIDEO = 2, T_AUDIO = 3, T_PREPARE = 4, T_CONFIG = 0x10, T_KEYFRAME, T_PAD, T_MOTION, T_PLAYERS, T_PAUSE, T_QUIT, T_MOTION_CLEAR, T_LTR_ACK, T_REFRESH };
+enum { MAX_MSG = 8 << 20, FRAMES = 240, MAX_SRC = 16, FORGET_NS = 100000000, MAX_ACK = 16 };
+
+static int g_fd = -1;
+static pthread_mutex_t g_wmu = PTHREAD_MUTEX_INITIALIZER;   // one message at a time on the socket; guards g_frame
+static pthread_t g_reader; static int g_reader_up;
+static uint32_t g_frame;
+static _Atomic int g_quit;
+
+// A graceful exit through the host's SIGTERM path (hle_lifecycle.c dm_host_shutdown: stops the writers, drains graphics, then _exit(0)); the process-directed kill reaches its signal source from any thread
+static void quit_default(void) { kill(getpid(), SIGTERM); }
+void (*stream_quit_hook)(void) = quit_default;
+static void quit_once(void) { if (!atomic_exchange(&g_quit, 1)) stream_quit_hook(); }
+
+static void put16(uint8_t *p, unsigned v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static void put32(uint8_t *p, uint32_t v) { for (int i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (8 * i)); }
+static void put64(uint8_t *p, uint64_t v) { for (int i = 0; i < 8; i++) p[i] = (uint8_t)(v >> (8 * i)); }
+static unsigned get16(const uint8_t *p) { return p[0] | p[1] << 8; }
+static uint32_t get32(const uint8_t *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+static uint64_t get64(const uint8_t *p) { return get32(p) | (uint64_t)get32(p + 4) << 32; }
+static float getf(const uint8_t *p) { uint32_t u = get32(p); float f; memcpy(&f, &u, 4); return f; }
+
+// One message: head (an bytes) then body (bn bytes) after the length and type; 0 ok, -1 failed. Callers hold g_wmu
+static int send_locked(int type, const void *a, size_t an, const void *b, size_t bn) {
+    uint8_t h[5]; put32(h, (uint32_t)(1 + an + bn)); h[4] = (uint8_t)type;
+    struct iovec iov[3] = {{h, 5}, {(void *)a, an}, {(void *)b, bn}}, *v = iov; int nv = 3;
+    while (nv) {
+        if (!v->iov_len) { v++; nv--; continue; }
+        ssize_t k = g_fd < 0 ? -1 : writev(g_fd, v, nv);
+        if (k < 0) { if (errno == EINTR) continue; return -1; }
+        while (k && nv) { if ((size_t)k >= v->iov_len) { k -= (ssize_t)v->iov_len; v++; nv--; } else { v->iov_base = (char *)v->iov_base + k; v->iov_len -= (size_t)k; k = 0; } }
+    }
+    return 0;
+}
+
+static _Atomic int g_preparing, g_prep_dropped;   // between stream_prepare_begin and _end (the prepare step below); a frame was dropped meanwhile
+static void video_sink(const uint8_t *d, size_t n, int flags, int32_t token, int w, int h, uint64_t capture_ns) {
+    if (atomic_load(&g_preparing)) { atomic_store(&g_prep_dropped, 1); return; }   // the prepare step: no video until it ends, and no frame number used
+    if (n > MAX_MSG - 22) {   // its number is used, so the front end sees the gap
+        LOG("[RED] stream: a %zu-byte frame is over the message limit: dropped", n);
+        pthread_mutex_lock(&g_wmu); g_frame++; pthread_mutex_unlock(&g_wmu); stream_video_keyframe(); return;
+    }
+    uint8_t hd[21]; put64(hd + 4, capture_ns); put16(hd + 12, (unsigned)w); put16(hd + 14, (unsigned)h); hd[16] = (uint8_t)flags; put32(hd + 17, (uint32_t)token);
+    pthread_mutex_lock(&g_wmu);
+    put32(hd, g_frame);
+    int r = send_locked(T_VIDEO, hd, sizeof hd, d, n);
+    if (!r) g_frame++;
+    pthread_mutex_unlock(&g_wmu);
+    if (r) quit_once();
+}
+
+// ---- sound: every silent sink pushes its 5 ms block; the first source to push is the clock and each of its pushes emits one stereo message, with at most one queued block from each other source ----
+typedef struct { const void *key; uint64_t last; int queued; int16_t pcm[FRAMES * 2]; } src_t;
+static src_t g_src[MAX_SRC]; static int g_clock = -1;
+static pthread_mutex_t g_mix = PTHREAD_MUTEX_INITIALIZER;
+static int16_t sat16(int32_t v) { return (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v); }
+
+// n frames of ch channels to stereo: 2 as is; a fold (the sink's six channels, then their stereo fold) the last two; 6 and 8 without one mixed at 0.7071 (front, centre, surround; LFE dropped); 1 doubled
+static void to_stereo(int16_t *o, const int16_t *s, int n, int ch, int fold) {
+    const float k = 0.7071f;
+    for (int i = 0; i < n; i++, s += ch) {
+        float l, r;
+        if (fold && ch >= 3) { l = s[ch - 2]; r = s[ch - 1]; }
+        else if (ch == 1) l = r = s[0];
+        else if (ch == 6) { l = s[0] + k * (s[2] + s[4]); r = s[1] + k * (s[2] + s[5]); }
+        else if (ch == 8) { l = s[0] + k * (s[2] + s[4] + s[6]); r = s[1] + k * (s[2] + s[5] + s[7]); }
+        else { l = s[0]; r = s[1]; }
+        *o++ = sat16((int32_t)l); *o++ = sat16((int32_t)r);
+    }
+}
+
+void stream_audio_pcm(const void *pcm16, size_t bytes, int ch, int has_fold, const void *source) {
+    stream_audio_pcm_at(pcm16, bytes, ch, has_fold, source, clock_gettime_nsec_np(CLOCK_UPTIME_RAW));
+}
+void stream_audio_pcm_at(const void *pcm16, size_t bytes, int ch, int has_fold, const void *source, uint64_t now) {
+    if (!pcm16 || ch < 1 || g_fd < 0 || atomic_load(&g_preparing)) return;   // the prepare step: no audio until it ends. now was read before the lock: another thread may have stored a later last, so a source is forgotten only when last < now
+    int n = (int)(bytes / (2 * (size_t)ch)); if (n > FRAMES) n = FRAMES;
+    int16_t blk[FRAMES * 2] = {0}; to_stereo(blk, pcm16, n, ch, has_fold);
+    pthread_mutex_lock(&g_mix);
+    int me = -1, free_i = -1;
+    for (int i = 0; i < MAX_SRC; i++) {
+        src_t *s = &g_src[i];
+        if (s->key && s->key != source && s->last < now && now - s->last > FORGET_NS) { s->key = NULL; s->queued = 0; if (g_clock == i) g_clock = -1; }
+        if (s->key == source) me = i; else if (!s->key && free_i < 0) free_i = i;
+    }
+    if (me < 0) { if (free_i < 0) { pthread_mutex_unlock(&g_mix); return; } me = free_i; g_src[me].key = source; g_src[me].queued = 0; }
+    g_src[me].last = now;
+    if (g_clock < 0) g_clock = me;
+    if (g_clock != me) { memcpy(g_src[me].pcm, blk, sizeof blk); g_src[me].queued = 1; pthread_mutex_unlock(&g_mix); return; }
+    int32_t acc[FRAMES * 2]; for (int i = 0; i < FRAMES * 2; i++) acc[i] = blk[i];
+    for (int j = 0; j < MAX_SRC; j++) if (j != me && g_src[j].key && g_src[j].queued) { for (int i = 0; i < FRAMES * 2; i++) acc[i] += g_src[j].pcm[i]; g_src[j].queued = 0; }
+    pthread_mutex_unlock(&g_mix);
+    uint8_t hd[9]; put64(hd, now); hd[8] = 2;
+    int16_t out[FRAMES * 2]; for (int i = 0; i < FRAMES * 2; i++) out[i] = sat16(acc[i]);   // stereo int16 in the host's (little-endian) byte order
+    pthread_mutex_lock(&g_wmu);
+    int r = send_locked(T_AUDIO, hd, sizeof hd, out, sizeof out);
+    pthread_mutex_unlock(&g_wmu);
+    if (r) quit_once();
+}
+
+// ---- the prepare step: the prepare message (phase 1, done 4, total 4); video and audio held back until it ends ----
+static int g_prep_phase, g_prep_ended; static uint64_t g_prep_last;   // under g_wmu: the phase last sent, its end sent, when the last message went
+int stream_prepare_wanted(void) {
+    const char *e = getenv("DM_STREAM_PREPARE");
+    return g_fd >= 0 && !atomic_load(&g_quit) && !(e && !strcmp(e, "0"));
+}
+void stream_prepare_begin(void) {
+    pthread_mutex_lock(&g_wmu); g_prep_phase = 0; g_prep_ended = 0; pthread_mutex_unlock(&g_wmu);
+    atomic_store(&g_prep_dropped, 0); atomic_store(&g_preparing, 1);
+}
+void stream_prepare(int phase, long done, long total) { stream_prepare_at(phase, done, total, clock_gettime_nsec_np(CLOCK_UPTIME_RAW)); }
+void stream_prepare_at(int phase, long done, long total, uint64_t now) {
+    if (g_fd < 0 || !atomic_load(&g_preparing) || phase < 1 || phase > 255) return;
+    if (total < 0) total = 0;
+    if (total > 0xffffffffL) total = 0xffffffffL;
+    if (done < 0) done = 0;
+    if (done > total) done = total;
+    pthread_mutex_lock(&g_wmu);
+    int start = phase != g_prep_phase, end = done == total;
+    if (!start && (g_prep_ended || (!end && now - g_prep_last < 250000000ull))) { pthread_mutex_unlock(&g_wmu); return; }   // at most 4 a second, the end once
+    uint8_t pl[9]; pl[0] = (uint8_t)phase; put32(pl + 1, (uint32_t)done); put32(pl + 5, (uint32_t)total);
+    int r = send_locked(T_PREPARE, pl, sizeof pl, NULL, 0);
+    g_prep_phase = phase; g_prep_ended = end; g_prep_last = now;
+    pthread_mutex_unlock(&g_wmu);
+    if (r) quit_once();
+}
+void stream_prepare_end(void) {
+    if (!atomic_exchange(&g_preparing, 0)) return;
+    if (atomic_exchange(&g_prep_dropped, 0)) stream_video_keyframe();   // the Host has seen nothing yet: the next frame starts the picture
+}
+
+// ---- reader ----
+static int read_all(int fd, void *p, size_t n) {
+    while (n) { ssize_t k = read(fd, p, n); if (k < 0 && errno == EINTR) continue; if (k <= 0) return -1; p = (char *)p + k; n -= (size_t)k; }
+    return 0;
+}
+// One message; -1 ends the stream. Every legal message from the front end is at most 66 bytes (an ltrAck of 16 tokens)
+static int handle(int type, const uint8_t *p, size_t n) {
+    static int paused, seen_cfg, seen_pad;
+    switch (type) {
+    case T_CONFIG:
+        if (n != 9) return -1;
+        if (!seen_cfg) { seen_cfg = 1; LOG("stream: first config %ux%u %u fps %u bit/s", get16(p), get16(p + 2), p[4], get32(p + 5)); }
+        stream_video_config(get16(p), get16(p + 2), p[4], (int)(get32(p + 5) > 0x7fffffffu ? 0x7fffffffu : get32(p + 5)));
+        return 0;
+    case T_KEYFRAME: if (n) return -1; stream_video_keyframe(); return 0;
+    case T_PAD: {
+        if (n != 25) return -1;
+        uint64_t b = get64(p + 1); int32_t ax[4]; for (int i = 0; i < 4; i++) ax[i] = (int32_t)get32(p + 9 + 4 * i);
+        if (b && !seen_pad) { seen_pad = 1; LOG("stream: first pad input (player %u, buttons 0x%llx)", p[0], (unsigned long long)b); }
+        if (p[0] == 0) dm_pad_set(b, ax[0], ax[1], ax[2], ax[3]);
+        else if (p[0] < DM_PLAYERS) dm_pad_set_player(p[0], b, ax[0], ax[1], ax[2], ax[3]);
+        return 0; }
+    case T_MOTION: {
+        if (n != 26) return -1;
+        float acc[3], rot[3]; for (int i = 0; i < 3; i++) { acc[i] = getf(p + 2 + 4 * i); rot[i] = getf(p + 14 + 4 * i); }
+        if (p[0] >= DM_PLAYERS) return 0;
+        if (p[1] == 1) { if (p[0] == 0) dm_motion_set_switch(0, acc, rot); }
+        else if (p[1] == 0) dm_motion_set(p[0], acc, rot);
+        return 0; }
+    case T_PLAYERS: if (n != 4) return -1; dm_pad_players(get32(p)); return 0;
+    case T_PAUSE:
+        if (n != 1) return -1;
+        if ((p[0] != 0) != paused) { paused = p[0] != 0; LOG("stream: %s", paused ? "paused" : "resumed"); dm_background(paused); }
+        return 0;
+    case T_MOTION_CLEAR: if (n != 1) return -1; if (p[0] < DM_PLAYERS) dm_motion_clear(p[0]); return 0;
+    case T_LTR_ACK: {
+        if (n < 1 || !p[0] || p[0] > MAX_ACK || n != 1 + 4 * (size_t)p[0]) return -1;
+        int32_t t[MAX_ACK]; for (int i = 0; i < p[0]; i++) t[i] = (int32_t)get32(p + 1 + 4 * i);
+        stream_video_ltr_ack(t, p[0]); return 0; }
+    case T_REFRESH: if (n) return -1; stream_video_refresh(); return 0;
+    default: return -1;   // quit, or a type this side does not know
+    }
+}
+static void *reader(void *arg) {
+    int fd = (int)(intptr_t)arg; uint8_t h[4], m[72];
+    for (;;) {
+        if (read_all(fd, h, 4)) break;
+        uint32_t len = get32(h);
+        if (len < 1 || len > MAX_MSG || len > sizeof m || read_all(fd, m, len)) break;   // m[0] is the type
+        if (handle(m[0], m + 1, len - 1)) break;
+    }
+    quit_once();
+    return NULL;
+}
+
+int stream_start(const char *title_id, const char *name) {
+    const char *path = getenv("DM_STREAM");
+    struct sockaddr_un sa = {.sun_family = AF_UNIX};
+    if (!path || !*path || strlen(path) >= sizeof sa.sun_path) { LOG("[RED] stream: DM_STREAM is not a usable socket path"); return -1; }
+    strcpy(sa.sun_path, path);
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) { LOG("[RED] stream: socket failed: %s", strerror(errno)); return -1; }
+    int one = 1, buf = 4 << 20; setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one); setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &buf, sizeof buf);
+    if (connect(fd, (struct sockaddr *)&sa, sizeof sa)) { LOG("[RED] stream: cannot connect to %s: %s", path, strerror(errno)); close(fd); return -1; }
+    if (g_reader_up) { pthread_join(g_reader, NULL); g_reader_up = 0; }   // a restart (the test): the previous reader has ended
+    if (g_fd >= 0) close(g_fd);
+    g_fd = fd; g_frame = 0; atomic_store(&g_quit, 0); atomic_store(&g_preparing, 0);
+    size_t nl = strlen(name); if (nl > 65535) { nl = 65535; while (nl && ((unsigned char)name[nl] & 0xC0) == 0x80) nl--; }   // cut on a character boundary
+    uint8_t hd[20] = {0}; put16(hd, STREAM_TAP_VERSION); memcpy(hd + 2, title_id, strnlen(title_id, 16)); put16(hd + 18, (unsigned)nl);
+    pthread_mutex_lock(&g_wmu); int r = send_locked(T_HELLO, hd, sizeof hd, name, nl); pthread_mutex_unlock(&g_wmu);
+    if (r) { LOG("[RED] stream: the hello could not be written: %s", strerror(errno)); return -1; }
+    stream_video_set_sink(video_sink);
+    LOG("stream: connected to the Host (tap protocol %d)", STREAM_TAP_VERSION);
+    if (pthread_create(&g_reader, NULL, reader, (void *)(intptr_t)fd)) { LOG("[RED] stream: cannot start the reader thread"); return -1; }
+    g_reader_up = 1;
+    return 0;
+}
diff --git a/dm/host/stream_video_mac.m b/dm/host/stream_video_mac.m
new file mode 100644
index 0000000000000000000000000000000000000000..e7f75ad625c92616e74d342c3fbd45fab70d3ca6
--- /dev/null
+++ b/dm/host/stream_video_mac.m
@@ -0,0 +1,208 @@
+// DM_STREAM video (stream.h): three IOSurface slots the present pass draws into (nvn_mtl.m stream_present), encoded as HEVC by VideoToolbox and handed to the sink.
+// A slot is busy from stream_video_surface until the encoder's output callback (or an abort, a drop); slot state and the config are under g_mu, the session under g_enc_mu
+// (taken before g_mu, never inside it: the output callback takes g_mu while the encode thread waits for it in VTCompressionSessionCompleteFrames).
+// Long-term references: a frame may carry a token; the front end acknowledges the tokens of frames it decoded, and after a loss asks for a refresh, a frame predicted only from an
+// acknowledged frame. Found on this encoder (HEVC, low-latency rate control): ForceLTRRefresh with no usable acknowledged frame gives a key frame whose next frames do not decode
+// (kVTVideoDecoderBadDataErr -12909, on a decoder given every frame); an acknowledgement of a token from before a key frame is no usable frame for it, one never issued is ignored.
+// So the tap passes only tokens issued since the last key frame and asks for a key frame itself when the encoder holds no acknowledgement since then.
+// A token on the wire is (epoch << 24) | the encoder's token: the epoch (7 bits) moves on with every session, whose tokens start again at 0, so an acknowledgement from an older session never matches
+#import <Foundation/Foundation.h>
+#import <VideoToolbox/VideoToolbox.h>
+#import <CoreVideo/CoreVideo.h>
+#include <stdatomic.h>
+#include "dm.h"
+#include "stream.h"
+
+enum { SLOTS = 3 };
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER, g_enc_mu = PTHREAD_MUTEX_INITIALIZER;
+static int g_max_w, g_max_h, g_max_fps, g_rate, g_key;   // under g_mu; g_max_w 0 = no config yet; g_key: the next frame encoded is a key frame
+static uint64_t g_due_ns, g_sent_ns;   // under g_mu: when the frame-rate cap's schedule expects the next frame, the newest frame handed to the encoder (the order)
+static int g_presents, g_over_cap, g_no_slot, g_ref_p, g_ref_key;   // under g_mu: this window of 600 presents, the frames the cap refused, those no free slot took, refreshes served as non-key and as key frames
+enum { ISSUED = 64, PEND = 32 };
+// Under g_mu: the session has long-term references; a refresh is asked for; a frame that carried acknowledgements came out of the encoder since the last key frame (the encoder holds them);
+// key frames handed to the encoder whose output has not come (the frames output before them are older than them); key frames and refreshes in flight (each repairs any loss before it); the epoch
+static int g_ltr, g_refresh, g_acked, g_key_wait, g_fix_wait, g_epoch, g_nissued, g_npend;
+static int32_t g_issued[ISSUED], g_pend[PEND];   // under g_mu: the newest encoder tokens issued since the session's last key frame (the only ones the encoder can refer to); acknowledged ones not yet passed
+static struct { CVPixelBufferRef pb; int w, h, busy, nack, repair; int32_t ack[PEND]; } g_slot[SLOTS];   // under g_mu; ack: the acknowledgements the slot's frame carries to the encoder; repair: the slot's frame was encoded with ForceLTRRefresh
+static VTCompressionSessionRef g_vt; static int g_vt_w, g_vt_h, g_vt_fps, g_vt_rate;   // under g_enc_mu
+static _Atomic(stream_frame_cb) g_sink;
+static _Atomic int g_fault;   // stream_video_fault (the test)
+void stream_video_fault(int faults) { atomic_store(&g_fault, faults); }
+
+void stream_video_set_sink(stream_frame_cb cb) { atomic_store(&g_sink, cb); }
+void stream_video_config(int max_w, int max_h, int max_fps, int bitrate) {
+    pthread_mutex_lock(&g_mu); g_max_w = max_w > 1 ? max_w : 0; g_max_h = max_h; g_max_fps = max_fps > 0 ? max_fps : 60; g_rate = bitrate; pthread_mutex_unlock(&g_mu);
+}
+void stream_video_keyframe(void) { pthread_mutex_lock(&g_mu); g_key = 1; pthread_mutex_unlock(&g_mu); }
+static int has(const int32_t *a, int n, int32_t t) { for (int i = 0; i < n; i++) if (a[i] == t) return 1; return 0; }
+// A token is kept only when it is of this session's epoch and the session issued it since its last key frame (a stale, unknown or older session's one is dropped), once; the newest PEND go with the next frame
+void stream_video_ltr_ack(const int32_t *tokens, int n) {
+    pthread_mutex_lock(&g_mu);
+    for (int i = 0; i < n && g_ltr; i++) {
+        int32_t t = tokens[i] & 0xffffff;
+        if (tokens[i] < 0 || tokens[i] >> 24 != g_epoch || !has(g_issued, g_nissued, t) || has(g_pend, g_npend, t)) continue;
+        if (g_npend == PEND) { memmove(g_pend, g_pend + 1, sizeof *g_pend * (PEND - 1)); g_npend--; }
+        g_pend[g_npend++] = t;
+    }
+    pthread_mutex_unlock(&g_mu);
+}
+// Under g_mu: the acknowledgements of a frame the encoder may not have taken go again with the next frame, ahead of newer ones (one the encoder took twice is harmless)
+static void ack_restore(const int32_t *a, int n) {
+    for (int i = n - 1; i >= 0 && g_npend < PEND; i--) if (has(g_issued, g_nissued, a[i]) && !has(g_pend, g_npend, a[i])) { memmove(g_pend + 1, g_pend, sizeof *g_pend * g_npend); g_pend[0] = a[i]; g_npend++; }
+}
+// A refresh while a key frame or a refresh is in the encoder is that one's: the loss it reports came before it (the loss of the repair frame itself is seen only after its output)
+void stream_video_refresh(void) { pthread_mutex_lock(&g_mu); if (!g_fix_wait) g_refresh = 1; pthread_mutex_unlock(&g_mu); }
+void stream_video_abort(int slot) { if (slot >= 0 && slot < SLOTS) { pthread_mutex_lock(&g_mu); g_slot[slot].busy = 0; pthread_mutex_unlock(&g_mu); } }
+// The picture scaled down to fit the maximum, aspect kept, never up, even dimensions (4:2:0)
+static void fit(int pw, int ph, int mw, int mh, int *w, int *h) {
+    if (pw <= mw && ph <= mh) { *w = pw; *h = ph; }
+    else if ((int64_t)pw * mh >= (int64_t)ph * mw) { *w = mw; *h = (int)((int64_t)ph * mw / pw); }
+    else { *h = mh; *w = (int)((int64_t)pw * mh / ph); }
+    *w = *w & ~1 ? *w & ~1 : 2; *h = *h & ~1 ? *h & ~1 : 2;
+}
+void *stream_video_surface(int pic_w, int pic_h, int *slot) {
+    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW), per; void *s = NULL; int i = 0, w, h, log_n = 0, log_a = 0, log_b = 0, log_c = 0, log_d = 0;
+    pthread_mutex_lock(&g_mu);
+    if (!g_max_w || pic_w <= 0 || pic_h <= 0) goto out;
+    per = 1000000000ull / g_max_fps;
+    if (++g_presents == 600) {
+        if (g_over_cap || g_no_slot || g_ref_p || g_ref_key) { log_n = g_presents; log_a = g_over_cap; log_b = g_no_slot; log_c = g_ref_p; log_d = g_ref_key; }
+        g_presents = g_over_cap = g_no_slot = g_ref_p = g_ref_key = 0;
+    }
+    // the cap keeps a schedule, not the last arrival: a frame is refused only when more than a quarter period early, so a game at the cap's rate keeps every frame through its jitter;
+    // a frame a period or more late leaves the next one due at once, so the frames after a long one, back on the game's own rhythm, are kept (the rate over any two periods stays within the cap plus one frame)
+    if (g_due_ns && now + per / 4 < g_due_ns) { g_over_cap++; goto out; }
+    while (i < SLOTS && g_slot[i].busy) i++;
+    if (i == SLOTS) { g_no_slot++; goto out; }   // every slot in flight: dropped, the present thread never waits
+    fit(pic_w, pic_h, g_max_w, g_max_h, &w, &h);
+    if (!g_slot[i].pb || g_slot[i].w != w || g_slot[i].h != h) {
+        CVPixelBufferRelease(g_slot[i].pb); g_slot[i].pb = NULL;
+        NSDictionary *a = @{(id)kCVPixelBufferIOSurfacePropertiesKey: @{}, (id)kCVPixelBufferMetalCompatibilityKey: @YES};
+        CVReturn r = CVPixelBufferCreate(NULL, w, h, kCVPixelFormatType_32BGRA, (__bridge CFDictionaryRef)a, &g_slot[i].pb);
+        if (r) { LOG("[RED] stream: CVPixelBufferCreate %dx%d failed: %d", w, h, r); g_slot[i].pb = NULL; goto out; }
+        g_slot[i].w = w; g_slot[i].h = h;
+    }
+    g_slot[i].busy = 1; g_due_ns = !g_due_ns ? now + per : now < g_due_ns + per ? g_due_ns + per : now; *slot = i; s = CVPixelBufferGetIOSurface(g_slot[i].pb);
+out:
+    pthread_mutex_unlock(&g_mu);
+    if (log_n) {
+        char rc[96] = "", rk[64] = "";
+        if (log_c) snprintf(rc, sizeof rc, ", %d refreshes as non-key frames", log_c);
+        if (log_d) snprintf(rk, sizeof rk, ", %d refreshes as key frames", log_d);
+        LOG("stream: %d presents, %d over the cap, %d no free slot%s%s", log_n, log_a, log_b, rc, rk);
+    }
+    return s;
+}
+static OSStatus vt_set(CFStringRef k, CFTypeRef v) {   // under g_enc_mu
+    OSStatus st = VTSessionSetProperty(g_vt, k, v);
+    if (st) LOG("[RED] stream: VTSessionSetProperty %s failed: %d", [(__bridge NSString *)k UTF8String], (int)st);
+    return st;
+}
+// Output: the sample's NAL units as they come (4-byte length prefixes), a key frame's VPS, SPS and PPS from the format description first
+static void enc_out(void *ref, void *src, OSStatus st, VTEncodeInfoFlags fl, CMSampleBufferRef sb) {
+    (void)ref; intptr_t tag = (intptr_t)src; int i = (int)(tag & 0xff) - 1, forced = tag >> 8 & 1, refresh = tag >> 9 & 1;   // the refcon: slot + 1, bit 8 set for a frame that was to be a key frame, bit 9 for one that serves a refresh
+    int out_ok = !st && sb && !(fl & kVTEncodeInfo_FrameDropped), key = 0; int flags; int32_t token = -1, wire = -1; static int big_logged;
+    if (out_ok) {
+        CFArrayRef at = CMSampleBufferGetSampleAttachmentsArray(sb, false);
+        CFDictionaryRef a0 = at && CFArrayGetCount(at) ? CFArrayGetValueAtIndex(at, 0) : NULL;
+        key = !(a0 && CFDictionaryContainsKey(a0, kCMSampleAttachmentKey_NotSync));
+        CFNumberRef tn = a0 ? CFDictionaryGetValue(a0, kVTSampleAttachmentKey_RequireLTRAcknowledgementToken) : NULL;
+        if (tn && (!CFNumberGetValue(tn, kCFNumberSInt32Type, &token) || token < 0)) token = -1;
+        if (token > 0xffffff) { if (!big_logged++) LOG("[RED] stream: long-term reference token %d does not fit 24 bits: sent as none", (int)token); token = -1; }
+    }
+    pthread_mutex_lock(&g_mu);   // one section with the slot's release: its acknowledgements are read before the slot can be taken again; before the sink, as the front end may acknowledge at once
+    g_slot[i].busy = 0; g_key |= !!st || (forced && !out_ok); g_refresh |= !st && refresh && !out_ok;   // a lost key frame or refresh is asked for again
+    g_key_wait -= forced; g_fix_wait -= forced || refresh;
+    if (!st && !out_ok) ack_restore(g_slot[i].ack, g_slot[i].nack);   // dropped: the encoder may not have taken them
+    if (out_ok) {
+        if (key) g_nissued = g_npend = g_acked = 0;   // a key frame ends every reference before it
+        else if (g_slot[i].nack && !g_key_wait) g_acked = 1;
+        if (token >= 0 && !g_key_wait) { if (g_nissued == ISSUED) { memmove(g_issued, g_issued + 1, sizeof *g_issued * (ISSUED - 1)); g_nissued--; } g_issued[g_nissued++] = token; }
+        if (token >= 0) wire = g_epoch << 24 | token;
+        if (refresh) { if (key) g_ref_key++; else g_ref_p++; }
+    }
+    flags = key ? STREAM_FRAME_KEY : out_ok && g_slot[i].repair ? STREAM_FRAME_REPAIR : 0;   // the mark follows the frame that was encoded with the option (its slot), and only when the encoder made a non-key frame of it
+    g_slot[i].repair = 0;
+    g_slot[i].nack = 0;
+    pthread_mutex_unlock(&g_mu);
+    if (st) { LOG("[RED] stream: HEVC encode failed: %d", (int)st); return; }
+    stream_frame_cb cb = atomic_load(&g_sink);
+    if (!cb || !out_ok) return;
+    if (refresh && key && !forced) { LOG("[RED] stream: the encoder answered a long-term reference refresh with a key frame: asking for another key frame"); stream_video_keyframe(); }   // the frames after such a key frame do not decode
+    CMFormatDescriptionRef fd = CMSampleBufferGetFormatDescription(sb); CMVideoDimensions dim = CMVideoFormatDescriptionGetDimensions(fd);
+    CMBlockBufferRef bb = CMSampleBufferGetDataBuffer(sb); size_t n = CMBlockBufferGetDataLength(bb), psn = 0, cnt = 0;
+    const uint8_t *ps[8]; size_t pl[8];
+    if (key) {
+        int hl = 0;
+        if (CMVideoFormatDescriptionGetHEVCParameterSetAtIndex(fd, 0, NULL, NULL, &cnt, &hl) || hl != 4) { LOG("[RED] stream: no HEVC parameter sets (length size %d)", hl); stream_video_keyframe(); return; }
+        for (size_t k = 0; k < cnt && k < 8; k++) {
+            if (CMVideoFormatDescriptionGetHEVCParameterSetAtIndex(fd, k, &ps[k], &pl[k], NULL, NULL)) { LOG("[RED] stream: HEVC parameter set %zu unreadable", k); stream_video_keyframe(); return; }
+            psn += 4 + pl[k];
+        }
+    }
+    uint8_t *out = malloc(psn + n), *o = out;
+    if (!out) { LOG("[RED] stream: no memory for a %zu-byte frame", psn + n); stream_video_keyframe(); return; }
+    for (size_t k = 0; key && k < cnt && k < 8; k++) { uint32_t l = (uint32_t)pl[k]; *o++ = l >> 24; *o++ = l >> 16; *o++ = l >> 8; *o++ = l; memcpy(o, ps[k], l); o += l; }
+    if (CMBlockBufferCopyDataBytes(bb, 0, n, o)) { LOG("[RED] stream: frame data unreadable"); stream_video_keyframe(); }
+    else cb(out, psn + n, flags, wire, dim.width, dim.height, (uint64_t)CMSampleBufferGetPresentationTimeStamp(sb).value);
+    free(out);
+}
+// The session for w x h, made again only when the size changes (its first frame a key frame); rate and frame rate follow the config. Under g_enc_mu
+static int enc_session(int w, int h, int fps, int rate, int *key) {
+    if (g_vt && (w != g_vt_w || h != g_vt_h)) {   // the old session's frames reach the sink first
+        VTCompressionSessionCompleteFrames(g_vt, kCMTimeInvalid); VTCompressionSessionInvalidate(g_vt); CFRelease(g_vt); g_vt = NULL;
+    }
+    if (!g_vt) {
+        NSDictionary *spec = @{(id)kVTVideoEncoderSpecification_EnableLowLatencyRateControl: @YES};
+        OSStatus st = VTCompressionSessionCreate(NULL, w, h, kCMVideoCodecType_HEVC, (__bridge CFDictionaryRef)spec, NULL, NULL, enc_out, NULL, &g_vt);
+        if (st) { LOG("[RED] stream: VTCompressionSessionCreate HEVC %dx%d failed: %d", w, h, (int)st); g_vt = NULL; return 0; }
+        vt_set(kVTCompressionPropertyKey_ProfileLevel, kVTProfileLevel_HEVC_Main_AutoLevel);
+        vt_set(kVTCompressionPropertyKey_RealTime, kCFBooleanTrue);
+        vt_set(kVTCompressionPropertyKey_AllowFrameReordering, kCFBooleanFalse);
+        vt_set(kVTCompressionPropertyKey_MaxKeyFrameInterval, (__bridge CFNumberRef)@(INT32_MAX));
+        int ltr = atomic_load(&g_fault) & STREAM_FAULT_NO_LTR ? (LOG("[RED] stream: VTSessionSetProperty EnableLTR failed: %d (test)", (int)kVTPropertyNotSupportedErr), 0) : !vt_set(kVTCompressionPropertyKey_EnableLTR, kCFBooleanTrue);   // off for this session when refused: tokens -1, a refresh is a key frame
+        pthread_mutex_lock(&g_mu); g_ltr = ltr; g_nissued = g_npend = g_acked = g_key_wait = g_fix_wait = 0; g_epoch = (g_epoch + 1) & 127; pthread_mutex_unlock(&g_mu);   // the old session's tokens mean nothing to this one
+        g_vt_w = w; g_vt_h = h; g_vt_fps = g_vt_rate = 0; *key = 1;
+        LOG("stream: HEVC %dx%d", w, h);
+        if (ltr) LOG("stream: long-term references on");
+    }
+    if (rate != g_vt_rate) { vt_set(kVTCompressionPropertyKey_AverageBitRate, (__bridge CFNumberRef)@(rate)); g_vt_rate = rate; }
+    if (fps != g_vt_fps) { vt_set(kVTCompressionPropertyKey_ExpectedFrameRate, (__bridge CFNumberRef)@(fps)); g_vt_fps = fps; }
+    return 1;
+}
+// Frames are encoded in the order they were presented: one older than a frame already sent (its GPU work finished later) is dropped
+void stream_video_submit(int slot, uint64_t capture_ns) { @autoreleasepool {
+    if (slot < 0 || slot >= SLOTS) return;
+    pthread_mutex_lock(&g_enc_mu); pthread_mutex_lock(&g_mu);
+    int late = capture_ns <= g_sent_ns, key = g_key, refresh = g_refresh, w = g_slot[slot].w, h = g_slot[slot].h, fps = g_max_fps, rate = g_rate; CVPixelBufferRef pb = g_slot[slot].pb;
+    if (late) g_slot[slot].busy = 0; else { g_sent_ns = capture_ns; g_key = g_refresh = 0; }
+    pthread_mutex_unlock(&g_mu);
+    if (!late) {
+        OSStatus st = -1; int ltr_ref = 0, made = 0, na = 0; int32_t ack[PEND];
+        if (enc_session(w, h, fps, rate, &key)) {   // a new session (key set) has no acknowledged token
+            made = 1;
+            pthread_mutex_lock(&g_mu);
+            na = key ? 0 : g_npend; memcpy(ack, g_pend, sizeof *ack * na); memcpy(g_slot[slot].ack, ack, sizeof *ack * na); g_slot[slot].nack = na; g_npend = 0;
+            // the encoder holds an acknowledgement since the last key frame, or this frame carries one (a refresh predicts from it in the same frame); else a key frame, decided here (see the top)
+            ltr_ref = refresh && !key && g_ltr && (g_acked || na); key |= refresh && !ltr_ref;
+            if (key) { g_nissued = g_acked = 0; g_key_wait++; }   // no token from before this key frame is acknowledged from here on
+            g_fix_wait += key || refresh;
+            g_slot[slot].repair = ltr_ref;   // read by enc_out for this frame
+            pthread_mutex_unlock(&g_mu);
+            NSMutableDictionary *fp = key || na || ltr_ref ? [NSMutableDictionary dictionary] : nil;
+            if (key) fp[(id)kVTEncodeFrameOptionKey_ForceKeyFrame] = @YES;
+            if (na) { NSMutableArray *a = [NSMutableArray arrayWithCapacity:na]; for (int i = 0; i < na; i++) [a addObject:@(ack[i])]; fp[(id)kVTEncodeFrameOptionKey_AcknowledgedLTRTokens] = a; }
+            if (ltr_ref) fp[(id)kVTEncodeFrameOptionKey_ForceLTRRefresh] = @YES;
+            st = atomic_fetch_and(&g_fault, ~STREAM_FAULT_ENCODE) & STREAM_FAULT_ENCODE ? kVTParameterErr : VTCompressionSessionEncodeFrame(g_vt, pb, CMTimeMake((int64_t)capture_ns, 1000000000), kCMTimeInvalid, (__bridge CFDictionaryRef)fp,
+                                                 (void *)(intptr_t)(slot + 1 + (key ? 0x100 : 0) + (refresh ? 0x200 : 0)), NULL);
+            if (st) LOG("[RED] stream: VTCompressionSessionEncodeFrame failed: %d", (int)st);
+        }
+        if (st) {   // no output callback comes for it: its acknowledgements go with the next frame
+            pthread_mutex_lock(&g_mu);
+            if (made) { g_key_wait -= key; g_fix_wait -= key || refresh; g_slot[slot].nack = 0; g_slot[slot].repair = 0; ack_restore(ack, na); }
+            g_slot[slot].busy = 0; g_key |= key; g_refresh |= refresh && !key;
+            pthread_mutex_unlock(&g_mu);
+        }
+    }
+    pthread_mutex_unlock(&g_enc_mu);
+} }
