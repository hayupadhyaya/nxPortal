+    CHECK(t == 2 && n == 21 + 3 && get32(m) == 1 && m[16] == 0 && get32(m + 17) == 70000 && !memcmp(m + 21, fr, 3), "video frame numbers count from 0 in the order sent; the token after key");
+    g_sink(fr, 4, 2, 5, 640, 360, 6);   // flags 2 (a repair frame) passes unchanged
+    t = recv_msg(m, sizeof m, &n, 1000);
+    CHECK(t == 2 && n == 21 + 4 && get32(m) == 2 && m[16] == 2 && get32(m + 17) == 5 && !memcmp(m + 21, fr, 4), "video message: the flags byte 2 (repair frame) goes from the sink to the socket unchanged");
