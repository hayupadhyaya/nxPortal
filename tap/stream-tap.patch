+      setenv("DM_STREAM_PREPARE", "1", 1);
+      CHECK(stream_prepare_wanted() == 1, "prepare: DM_STREAM_PREPARE=1 is");
+      unsetenv("DM_STREAM_PREPARE");
+      g_sink(fr, 3, 1, -1, 640, 360, 11);
+      t = recv_msg(m, sizeof m, &n, 1000);
+      CHECK(t == 2 && get32(m) == 0, "prepare: without a prepare step video flows from the first frame");
+      drop_tap(); wait_ge(&g_quit_n, qn + 1); }
+
+    // (l) no listener
+    CHECK(stream_start("0400486024DEC000", "Test") != 0, "stream_start without a listener fails");
+    char longp[200]; memset(longp, 'x', sizeof longp - 1); longp[sizeof longp - 1] = 0; setenv("DM_STREAM", longp, 1);
+    CHECK(stream_start("0400486024DEC000", "Test") != 0, "a path too long for sun_path fails");
+
+    rmdir(g_dir);
+    printf("t_stream: %d checks, %d failed\n", checks, fails);
