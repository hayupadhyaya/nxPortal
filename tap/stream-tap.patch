diff --git a/dm/gfx/tests/t_stream_prepare.m b/dm/gfx/tests/t_stream_prepare.m
new file mode 100644
index 0000000000000000000000000000000000000000..d31303e43ce172295a8e9a680cf8d66bea9f4137
--- /dev/null
+++ b/dm/gfx/tests/t_stream_prepare.m
@@ -0,0 +1,58 @@
+// DM_STREAM's prepare step on the graphics side (nvn_mtl.m prepare_on, warm_start; hle_nvn.c dm_gfx_quit_ms): with the tap connected and no window, the first submission's prepare
+// step runs before the first frame, between the tap's begin and end, and while it runs a graceful exit gives the archive DM_QUIT_PREPARE_MS, else DM_QUIT_ARCH_MS. With
+// DM_STREAM_PREPARE=0 (the tap's stream_prepare_wanted says no) there is no prepare step and no begin. Each case runs in a process of its own (prepare_on is read once): this binary
+// runs itself with --case. The tap's calls are recorded by t_stream_prepare_tap.c; the prewarm list is one comment line (phase 1: 0 of 0) and DM_PSO_PREBUILD=0 (no phase 2)
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+extern int g_tap_wanted_n, g_tap_begin_n, g_tap_end_n, g_tap_prep_n, g_tap_last[3], g_tap_prep_preparing, g_tap_prep_quit_ms;
+
+static int checks, failed;
+#define EXPECT(name, want, got) do { long w_ = (long)(want), g_ = (long)(got); checks++; \
+    if (w_ != g_) { fprintf(stderr, "%s: expected %ld, got %ld\n", name, w_, g_); failed++; } } while (0)
+
+static int one_case(const char *c) {
+    int on = !strcmp(c, "on");
+    EXPECT("before the first submission: not preparing, the exit gives the archive DM_QUIT_ARCH_MS", DM_QUIT_ARCH_MS, dm_gfx_quit_ms());
+    mtl_prepare();   // the first submission's prepare step
+    EXPECT("the prepare step is on", on, prepare_on());
+    EXPECT("the tap's begin", on, g_tap_begin_n);
+    EXPECT("the tap's end", on, g_tap_end_n);
+    EXPECT("one prepare call: phase 1, 0 of 0 (the list holds nothing)", on, g_tap_prep_n);
+    if (on) {
+        EXPECT("phase 1", 1, g_tap_last[0]); EXPECT("done 0", 0, g_tap_last[1]); EXPECT("total 0", 0, g_tap_last[2]);
+        EXPECT("during it: the stream's prepare step is under way", 1, g_tap_prep_preparing);
+        EXPECT("during it: the exit gives the archive DM_QUIT_PREPARE_MS", DM_QUIT_PREPARE_MS, g_tap_prep_quit_ms);
+    }
+    EXPECT("after it: not preparing", 0, mtl_stream_preparing());
+    EXPECT("after it: the exit gives the archive DM_QUIT_ARCH_MS", DM_QUIT_ARCH_MS, dm_gfx_quit_ms());
+    printf("t_stream_prepare --case %s: %d checks, %d failed\n", c, checks, failed);
+    return failed != 0;
+}
+static int run_self(const char *c, NSDictionary<NSString *, NSString *> *env) {
+    NSMutableDictionary *e = [NSProcessInfo.processInfo.environment mutableCopy]; [e addEntriesFromDictionary:env];
+    NSTask *t = [NSTask new]; t.executableURL = [NSURL fileURLWithPath:NSProcessInfo.processInfo.arguments[0]]; t.arguments = @[@"--case", @(c)]; t.environment = e;
+    if (![t launchAndReturnError:nil]) return -1;
+    [t waitUntilExit]; return t.terminationStatus;
+}
+int main(int argc, char **argv) {
+    if (argc == 3 && !strcmp(argv[1], "--case")) return one_case(argv[2]);
+    @autoreleasepool {
+        NSString *dir = [NSTemporaryDirectory() stringByAppendingPathComponent:[NSString stringWithFormat:@"t_stream_prepare.%d", getpid()]], *list = [dir stringByAppendingPathComponent:@"pso_manifest.tsv"];
+        [NSFileManager.defaultManager createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil];
+        [@"# nothing to build\n" writeToFile:list atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        NSString *map = [dir stringByAppendingPathComponent:@"shader_map.tsv"];   // a shader map with no shaders
+        [@"package\tindex\tstage\tdm_ctl_sha16\tsource\n" writeToFile:map atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        NSDictionary *base = @{@"DM_STREAM": @"/nonexistent", @"DM_NVN_SHMAP": map, @"DM_MSL_DIR": dir, @"DM_PSO_MANIFEST": list, @"DM_PSO_PREBUILD": @"0", @"DM_PSO_HYBRID": @"0", @"DM_PSO_ARCHIVE": @"off"};
+        NSMutableDictionary *off = [base mutableCopy]; off[@"DM_STREAM_PREPARE"] = @"0";
+        int a = run_self("on", base), b = run_self("off", off);
+        EXPECT("stream, prepare wanted: the case passes", 0, a);
+        EXPECT("stream, DM_STREAM_PREPARE=0: the case passes", 0, b);
+        [NSFileManager.defaultManager removeItemAtPath:dir error:nil];
+    }
+    printf("t_stream_prepare: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+}
