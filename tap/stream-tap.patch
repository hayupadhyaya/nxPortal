+    g_sink(fr, (8u << 20) - 21, 0, -1, 640, 360, 7);   // over the message limit by one byte: dropped before its bytes are read
+    CHECK(get(&g_key_n) == keys + 1, "an oversized frame asks for a key frame");
+    g_sink(fr, 3, 0, -1, 640, 360, 8);
+    t = recv_msg(m, sizeof m, &n, 1000);
+    CHECK(t == 2 && get32(m) == 4, "an oversized frame is dropped with its number: the next is frame 4");
+
+    // (k) the listener closes: the hook once
+    CHECK(get(&g_quit_n) == 0, "no quit so far");
+    drop_tap();
+    CHECK(wait_ge(&g_quit_n, 1), "a closed socket calls the hook"); usleep(30000); CHECK(get(&g_quit_n) == 1, "once");
+
+    // (i) a length above 8 MiB
+    connect_tap(); recv_msg(m, sizeof m, &n, 1000);
+    { uint8_t h[4]; put32(h, 0x00900000); send_raw(h, 4); }
+    CHECK(wait_ge(&g_quit_n, 2), "a length of 0x00900000 calls the hook"); usleep(30000); CHECK(get(&g_quit_n) == 2, "once");
+    drop_tap(); usleep(30000); CHECK(get(&g_quit_n) == 2, "the closing after a quit does not call it again");
+
+    // (j) quit
+    connect_tap(); recv_msg(m, sizeof m, &n, 1000);
+    send_msg(0x16, NULL, 0);
+    CHECK(wait_ge(&g_quit_n, 3), "quit calls the hook"); usleep(30000); CHECK(get(&g_quit_n) == 3, "once");
+    drop_tap();
+
+    // an unknown type and a wrong size also end it
+    connect_tap(); recv_msg(m, sizeof m, &n, 1000);
+    send_msg(0x7f, NULL, 0);
+    CHECK(wait_ge(&g_quit_n, 4), "an unknown type calls the hook");
+    drop_tap(); connect_tap(); recv_msg(m, sizeof m, &n, 1000);
+    send_msg(0x15, pl, 2);
+    CHECK(wait_ge(&g_quit_n, 5), "a message of the wrong size calls the hook");
+    drop_tap();
+
+    // ltrAck and refresh reach the video code; a wrong size of either ends the stream
+    connect_tap(); recv_msg(m, sizeof m, &n, 1000);
+    { uint8_t a[1 + 64]; a[0] = 3; put32(a + 1, 0); put32(a + 5, 0x7fffffff); put32(a + 9, (uint32_t)-2); send_msg(0x18, a, 13);
