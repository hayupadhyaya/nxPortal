@@ -0,0 +1,12 @@
+// The tap's prepare calls (dm/host/stream_mac.c) for t_stream_prepare: strong definitions over nvn_mtl.m's weak ones. Each call is recorded with what the graphics side says while it is made
+#include <stdlib.h>
+#include <string.h>
+int mtl_stream_preparing(void); int dm_gfx_quit_ms(void);
+int g_tap_wanted_n, g_tap_begin_n, g_tap_end_n, g_tap_prep_n, g_tap_last[3], g_tap_prep_preparing, g_tap_prep_quit_ms, g_tap_begin_after_end;
+int stream_prepare_wanted(void) { const char *e = getenv("DM_STREAM_PREPARE"); g_tap_wanted_n++; return !(e && !strcmp(e, "0")); }
+void stream_prepare_begin(void) { g_tap_begin_n++; }
+void stream_prepare(int phase, long done, long total) {
+    g_tap_prep_n++; g_tap_last[0] = phase; g_tap_last[1] = (int)done; g_tap_last[2] = (int)total;
+    g_tap_prep_preparing = mtl_stream_preparing(); g_tap_prep_quit_ms = dm_gfx_quit_ms();
+}
+void stream_prepare_end(void) { g_tap_end_n++; }
diff --git a/dm/gfx/tests/t_stream_present.m b/dm/gfx/tests/t_stream_present.m
new file mode 100644
index 0000000000000000000000000000000000000000..234bc703f99fc15c01c4dc267e6ccdab60184621
--- /dev/null
+++ b/dm/gfx/tests/t_stream_present.m
@@ -0,0 +1,301 @@
+// DM_STREAM: present_now draws the picture into the stream's IOSurface and the encoder hands HEVC frames to the sink, never touching a window (dm/host/stream.h).
+// Real Metal 4 queue and VideoToolbox; frames are decoded back with VTDecompressionSession. One present at a time, at least 1/60 s apart, each waited for at the sink.
+// Long-term references: frames are decoded as a front end that lost some sees them, the refresh after the loss decoding without them
+#include "../nvn/nvn_mtl.m"
+#import <VideoToolbox/VideoToolbox.h>
+static int g_layer_calls;
+void *front_metal_layer(void) { g_layer_calls++; return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(name, ok) do { int pass = !!(ok); checks++; failed += !pass; printf("%s: %s\n", name, pass ? "PASS" : "FAIL"); } while (0)
+typedef struct { NSData *d; int fl, token, w, h; uint64_t ns; } frame;
+static frame g_fr[512]; static int g_nfr; static pthread_mutex_t g_fr_mu = PTHREAD_MUTEX_INITIALIZER; static dispatch_semaphore_t g_fr_sem;
+static void sink(const uint8_t *data, size_t n, int fl, int32_t token, int w, int h, uint64_t capture_ns) {
+    pthread_mutex_lock(&g_fr_mu); if (g_nfr < 512) g_fr[g_nfr++] = (frame){[NSData dataWithBytes:data length:n], fl, token, w, h, capture_ns}; pthread_mutex_unlock(&g_fr_mu);
+    dispatch_semaphore_signal(g_fr_sem);
+}
+static int frames(void) { pthread_mutex_lock(&g_fr_mu); int n = g_nfr; pthread_mutex_unlock(&g_fr_mu); return n; }
+static tex_t source(unsigned serial, int w, int h, uint8_t r, uint8_t g, uint8_t b) {   // one flat colour, RGBA8
+    MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:w height:h mipmapped:NO];
+    d.storageMode = MTLStorageModeShared; d.usage = MTLTextureUsageShaderRead;
+    id<MTLTexture> mt = [g_dev newTextureWithDescriptor:d]; uint8_t *px = malloc((size_t)w * h * 4);
+    for (int i = 0; i < w * h; i++) { px[4 * i] = r; px[4 * i + 1] = g; px[4 * i + 2] = b; px[4 * i + 3] = 255; }
+    [mt replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4]; free(px);
+    tex_t t = {.magic=MAGIC('T','E','X',0), .serial=serial};
+    t.d.width = w; t.d.height = h; t.d.depth = t.d.levels = t.d.samples = 1;
+    t.d.target = NVN_TEXTURE_TARGET_2D; t.d.format = NVN_FORMAT_RGBA8;
+    serial_put(t.serial, mt); res_add(mt); res_commit(); return t;
+}
+static uint64_t g_ticket, g_last_ns; static int g_bad_returns, g_last_ret;
+static void present_at(const tex_t *t, uint64_t due) {   // at due (CLOCK_UPTIME_RAW): asleep until 8 ms before, then spinning, as a sleep can overrun by several ms
+    uint64_t now;
+    while ((now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW)) + 8000000 < due) { struct timespec ts = {0, (long)(due - now - 8000000)}; nanosleep(&ts, NULL); }
+    while ((now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW)) < due) {}
+    g_last_ns = now;
+    mtl_present_layer(t->d.width, t->d.height);   // the picture's shape is the source's (present_shape)
+    @autoreleasepool { g_last_ret = present_now(t, 1. / 60, 0, ++g_ticket, NULL, 0, nil, 0); g_bad_returns += g_last_ret != 0 && g_last_ret != 1; }
+}
+// The present queue's accounting (g_pq_mu): presents in flight on the GPU, the newest ticket done; an object in the residency set; nothing in flight within 5 s
+static int inflight(void) { pthread_mutex_lock(&g_pq_mu); int n = g_pq_inflight; pthread_mutex_unlock(&g_pq_mu); return n; }
+static uint64_t done_tk(void) { pthread_mutex_lock(&g_pq_mu); uint64_t d = g_pq_done; pthread_mutex_unlock(&g_pq_mu); return d; }
+static int resident(id o) { pthread_mutex_lock(&g_res_mu); int r = [g_res_objects containsObject:o]; pthread_mutex_unlock(&g_res_mu); return r; }
+static int settle(void) {
+    pthread_mutex_lock(&g_pq_mu); struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_sec += 5;
+    while (g_pq_inflight && pthread_cond_timedwait(&g_pq_cv, &g_pq_mu, &ts) != ETIMEDOUT) {}
+    int n = g_pq_inflight; pthread_mutex_unlock(&g_pq_mu); return n == 0;
+}
+static void drain_sink(void) { usleep(300000); while (!dispatch_semaphore_wait(g_fr_sem, DISPATCH_TIME_NOW)) {} }
+static void present(const tex_t *t) { present_at(t, g_last_ns + 1000000000ull / 60 + 200000); }   // the 60 fps cap never drops it
+static int present_wait(const tex_t *t) {   // the frame reached the sink within 2 s
+    present(t); return dispatch_semaphore_wait(g_fr_sem, dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC)) == 0;
+}
+static int nal_type(const uint8_t *p) { return (p[0] >> 1) & 0x3f; }
+static int starts_with_ps(NSData *d) {   // VPS, SPS, PPS, each 4-byte length-prefixed
+    const uint8_t *p = d.bytes; size_t n = d.length, o = 0; static const int want[3] = {32, 33, 34};
+    for (int k = 0; k < 3; k++) { if (o + 5 > n) return 0; uint32_t l = (uint32_t)p[o] << 24 | p[o + 1] << 16 | p[o + 2] << 8 | p[o + 3]; if (nal_type(p + o + 4) != want[k]) return 0; o += 4 + l; }
+    return 1;
+}
+static size_t ps_len(const uint8_t *p) { size_t o = 0; for (int i = 0; i < 3; i++) o += 4 + ((uint32_t)p[o] << 24 | p[o + 1] << 16 | p[o + 2] << 8 | p[o + 3]); return o; }   // a key frame's VPS, SPS, PPS
+// Decodes the frames idx[0..n) in that order (the first a key frame), as a front end that never received the others, to BGRA and keeps the centre pixel of each.
+// Returns how many decoded before the first failed decode call or callback (n: all)
+static int decode_idx(const int *idx, int n, uint8_t centre[][4]) {
+    const uint8_t *ps[3]; size_t psn[3]; NSData *k = g_fr[idx[0]].d; const uint8_t *p = k.bytes; size_t o = 0;
+    for (int i = 0; i < 3; i++) { uint32_t l = (uint32_t)p[o] << 24 | p[o + 1] << 16 | p[o + 2] << 8 | p[o + 3]; ps[i] = p + o + 4; psn[i] = l; o += 4 + l; }
+    CMVideoFormatDescriptionRef fd = NULL;
+    if (CMVideoFormatDescriptionCreateFromHEVCParameterSets(NULL, 3, ps, psn, 4, NULL, &fd)) return 0;
+    NSDictionary *attrs = @{(id)kCVPixelBufferPixelFormatTypeKey: @(kCVPixelFormatType_32BGRA)};
+    VTDecompressionSessionRef ds = NULL;
+    if (VTDecompressionSessionCreate(NULL, fd, NULL, (__bridge CFDictionaryRef)attrs, NULL, &ds)) { CFRelease(fd); return 0; }
+    int ok = 1, i = 0;
+    for (; i < n && ok; i++) {
+        NSData *d = g_fr[idx[i]].d; size_t skip = 0;
+        if ((g_fr[idx[i]].fl & STREAM_FRAME_KEY)) skip = ps_len(d.bytes);   // the parameter sets are in the format description (one size: the same sets)
+        CMBlockBufferRef bb = NULL; CMSampleBufferRef sb = NULL; size_t len = d.length - skip;
+        CMBlockBufferCreateWithMemoryBlock(NULL, NULL, len, NULL, NULL, 0, len, kCMBlockBufferAssureMemoryNowFlag, &bb);
+        CMBlockBufferReplaceDataBytes((const uint8_t *)d.bytes + skip, bb, 0, len);
+        CMSampleBufferCreateReady(NULL, bb, fd, 1, 0, NULL, 1, &len, &sb);
+        __block int got = 0; uint8_t *c = centre[i];
+        OSStatus st = VTDecompressionSessionDecodeFrameWithOutputHandler(ds, sb, 0, NULL, ^(OSStatus s, VTDecodeInfoFlags f, CVImageBufferRef img, CMTime pts, CMTime dur) {
+            (void)f; (void)pts; (void)dur; if (s || !img) return;
+            CVPixelBufferLockBaseAddress(img, kCVPixelBufferLock_ReadOnly);
+            const uint8_t *b = CVPixelBufferGetBaseAddress(img); size_t bpr = CVPixelBufferGetBytesPerRow(img);
+            memcpy(c, b + CVPixelBufferGetHeight(img) / 2 * bpr + CVPixelBufferGetWidth(img) / 2 * 4, 4);
+            CVPixelBufferUnlockBaseAddress(img, kCVPixelBufferLock_ReadOnly); got = 1; });
+        VTDecompressionSessionWaitForAsynchronousFrames(ds);
+        ok = !st && got; CFRelease(sb); CFRelease(bb);
+        if (!ok) printf("frame %d (decoded %d of %d) did not decode: call %d, picture %d\n", idx[i], i, n, (int)st, got);
+    }
+    VTDecompressionSessionInvalidate(ds); CFRelease(ds); CFRelease(fd); return ok ? n : i - 1;
+}
+static int decode(int first, int n, uint8_t centre[][4]) { int idx[64]; for (int i = 0; i < n; i++) idx[i] = first + i; return decode_idx(idx, n, centre) == n; }
+static int near(const uint8_t bgra[4], int r, int g, int b) { return abs(bgra[2] - r) <= 12 && abs(bgra[1] - g) <= 12 && abs(bgra[0] - b) <= 12; }
+static int last(void) { return frames() - 1; }
+static void ack(int f) { if (g_fr[f].token >= 0) stream_video_ltr_ack(&g_fr[f].token, 1); }   // the front end decoded frame f
+// A key frame, then n frames of t, each acknowledged as it arrives (the front end decodes them all); returns the key frame's index
+static int key_then_acked(const tex_t *t, int n) {
+    stream_video_keyframe(); present_wait(t); int k = last();
+    for (int i = 0; i < n; i++) { ack(last()); present_wait(t); }
+    return k;
+}
+// The loss: frames k0..k decoded (k acknowledged), 4 frames of `lost` never reach the front end, then (with refresh) a refresh and 10 frames of `after`.
+// Fills idx with what the front end decodes and returns its count; *r is the first frame after the loss
+static int lose_four(int k0, const tex_t *lost, const tex_t *after, int refresh, int idx[], int *r) {
+    int n = 0; for (int f = k0; f <= last(); f++) idx[n++] = f;
+    ack(last()); for (int i = 0; i < 4; i++) present_wait(lost);
+    if (refresh) stream_video_refresh();
+    present_wait(after); *r = last(); for (int i = 0; i < 10; i++) present_wait(after);
+    for (int f = *r; f <= last(); f++) idx[n++] = f;
+    return n;
+}
+// Every frame from idx[from] on decodes to the colour (r, g, b)
+static int all_near(uint8_t c[][4], int from, int n, int r, int g, int b) { for (int i = from; i < n; i++) if (!near(c[i], r, g, b)) return 0; return 1; }
