+    usleep(130000);
+    fill(2, 400); stream_audio_pcm(blk, 240 * 2 * 2, 2, 0, &b1);
+    CHECK(audio_is(400), "the clock was forgotten: the next source to push is the clock");
+    fill(2, 100); stream_audio_pcm(blk, 240 * 2 * 2, 2, 0, &a1);
+    CHECK(no_message(), "the old clock is a plain source again");
+    fill(2, 400); stream_audio_pcm(blk, 240 * 2 * 2, 2, 0, &b1);
+    CHECK(audio_is(500), "and its queued block is mixed in");
+
+    // sink threads read their clock before taking the mixer's lock: a push stamped slightly before the clock's last one must not forget the clock
+    { uint64_t T = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + 10000000000ull; int ca = 0, cb = 0;
