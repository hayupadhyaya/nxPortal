+      { const uint8_t want[14] = {10, 0, 0, 0, 4, 2, 0x34, 0x12, 0, 0, 0x78, 0x56, 0x34, 0x12}; uint8_t raw[14];
+        stream_prepare_at(2, 0x1234, 0x12345678, T); CHECK(read_fully(raw, 14, 1000) && !memcmp(raw, want, 14), "prepare: the bytes on the socket, little-endian (phase 2 start)"); }
