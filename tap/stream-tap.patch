+    CHECK(get(&g_bg_n) == 2 && g_bg_seq[0] == 1 && g_bg_seq[1] == 0, "a repeated pause is ignored: dm_background(1) once, then (0) once");
+
+    // (g) sound
+    int a1 = 0, b1 = 0, c1 = 0;   // three distinct sources
+    stream_quit_hook = test_quit;
+    fill(2, 1000); stream_audio_pcm(blk, 240 * 2 * 2, 2, 0, &a1);
