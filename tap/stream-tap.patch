+      } }
+
+    // (m) the prepare step: prepare messages (0x04: phase 1, done 4, total 4), hello first, no video or audio until it ends, the rate limit, the end once, quit meanwhile, the switch
+    { CHECK(stream_prepare_wanted() == 0, "prepare: not wanted once the stream has ended");
+      int qn = get(&g_quit_n), keys0, src = 0;
+      connect_tap();
+      unsetenv("DM_STREAM_PREPARE");
+      CHECK(stream_prepare_wanted() == 1, "prepare: wanted when connected (DM_STREAM_PREPARE unset)");
