+      drop_tap(); CHECK(wait_ge(&g_quit_n, 6), "closing it calls the hook");   // counted before the wrong sizes, each of which must add exactly one
+      struct { uint8_t type, len, a0; const char *what; } bad[] = {{0x18, 1, 0, "ltrAck with a count of 0"}, {0x18, 9, 3, "ltrAck shorter than its count"}, {0x18, 13, 2, "ltrAck longer than its count"},
