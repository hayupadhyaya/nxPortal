+// DM_STREAM tap (stream_mac.c): a Unix socket listener plays the streaming front end. Checks the hello, input and pause messages mapped to the dm_* calls, the sound mix (one audio message per push
+// of the clock source), the video message, the prepare messages, and the single quit on a bad length, a quit message or a closed socket. The dm_* and stream_video_* functions are stubs
+// that record their arguments
+#include <errno.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include "dm_input.h"
+#include "stream.h"
+
+int stream_start(const char *title_id, const char *name);
+void stream_audio_pcm(const void *pcm16, size_t bytes, int ch, int has_fold, const void *source);
+extern void (*stream_quit_hook)(void);
+
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+static int checks, fails;
+
+// ---- stubs: each records what the reader thread called ----
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static struct { int n, player; uint64_t buttons; int32_t ax[4]; } g_pad, g_padp;   // dm_pad_set (player 0), dm_pad_set_player
+static struct { int n, player; float acc[3], rot[3]; } g_msw, g_mot;   // dm_motion_set_switch, dm_motion_set
+static int g_mclear_n, g_mclear_player, g_players_n; static uint32_t g_players;
+static int g_cfg_n, g_cfg[4], g_key_n, g_bg_n, g_bg_seq[8], g_quit_n, g_ack_n, g_ack_count, g_refresh_n; static int32_t g_ack[16];
+static stream_frame_cb g_sink;
+void dm_pad_set(uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) { pthread_mutex_lock(&g_mu); g_pad.n++; g_pad.buttons = b; g_pad.ax[0] = lx; g_pad.ax[1] = ly; g_pad.ax[2] = rx; g_pad.ax[3] = ry; pthread_mutex_unlock(&g_mu); }
+void dm_pad_set_player(int p, uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) { pthread_mutex_lock(&g_mu); g_padp.n++; g_padp.player = p; g_padp.buttons = b; g_padp.ax[0] = lx; g_padp.ax[1] = ly; g_padp.ax[2] = rx; g_padp.ax[3] = ry; pthread_mutex_unlock(&g_mu); }
+void dm_pad_players(uint32_t m) { pthread_mutex_lock(&g_mu); g_players_n++; g_players = m; pthread_mutex_unlock(&g_mu); }
+void dm_motion_set_switch(int p, const float a[3], const float r[3]) { pthread_mutex_lock(&g_mu); g_msw.n++; g_msw.player = p; memcpy(g_msw.acc, a, 12); memcpy(g_msw.rot, r, 12); pthread_mutex_unlock(&g_mu); }
+void dm_motion_set(int p, const float a[3], const float r[3]) { pthread_mutex_lock(&g_mu); g_mot.n++; g_mot.player = p; memcpy(g_mot.acc, a, 12); memcpy(g_mot.rot, r, 12); pthread_mutex_unlock(&g_mu); }
+void dm_motion_clear(int p) { pthread_mutex_lock(&g_mu); g_mclear_n++; g_mclear_player = p; pthread_mutex_unlock(&g_mu); }
+void dm_background(int on) { pthread_mutex_lock(&g_mu); if (g_bg_n < 8) g_bg_seq[g_bg_n] = on; g_bg_n++; pthread_mutex_unlock(&g_mu); }
+void stream_video_config(int w, int h, int fps, int br) { pthread_mutex_lock(&g_mu); g_cfg_n++; g_cfg[0] = w; g_cfg[1] = h; g_cfg[2] = fps; g_cfg[3] = br; pthread_mutex_unlock(&g_mu); }
+void stream_video_keyframe(void) { pthread_mutex_lock(&g_mu); g_key_n++; pthread_mutex_unlock(&g_mu); }
+void stream_video_ltr_ack(const int32_t *t, int n) { pthread_mutex_lock(&g_mu); g_ack_n++; g_ack_count = n; for (int i = 0; i < n && i < 16; i++) g_ack[i] = t[i]; pthread_mutex_unlock(&g_mu); }
+void stream_video_refresh(void) { pthread_mutex_lock(&g_mu); g_refresh_n++; pthread_mutex_unlock(&g_mu); }
+void stream_video_set_sink(stream_frame_cb cb) { g_sink = cb; }
+static void test_quit(void) { pthread_mutex_lock(&g_mu); g_quit_n++; pthread_mutex_unlock(&g_mu); }
+
+// Waits (at most 2 s) until *v >= want, read under the stubs' lock
+static int wait_ge(const int *v, int want) {
+    for (int i = 0; i < 2000; i++) { pthread_mutex_lock(&g_mu); int ok = *v >= want; pthread_mutex_unlock(&g_mu); if (ok) return 1; usleep(1000); }
+    return 0;
+}
+static int get(const int *v) { pthread_mutex_lock(&g_mu); int r = *v; pthread_mutex_unlock(&g_mu); return r; }
+
+// ---- the front end's side ----
+static char g_dir[64], g_path[96];
+static int g_lfd = -1, g_cfd = -1;
+static void listen_on(void) {
+    struct sockaddr_un sa = {.sun_family = AF_UNIX}; strncpy(sa.sun_path, g_path, sizeof sa.sun_path - 1);
+    unlink(g_path); g_lfd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (g_lfd < 0 || bind(g_lfd, (struct sockaddr *)&sa, sizeof sa) || listen(g_lfd, 1)) { perror("listen"); exit(2); }
+}
+static void put16(uint8_t *p, unsigned v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static void put32(uint8_t *p, uint32_t v) { for (int i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (8 * i)); }
+static void put64(uint8_t *p, uint64_t v) { for (int i = 0; i < 8; i++) p[i] = (uint8_t)(v >> (8 * i)); }
+static void putf(uint8_t *p, float f) { uint32_t u; memcpy(&u, &f, 4); put32(p, u); }
+static unsigned get16(const uint8_t *p) { return p[0] | p[1] << 8; }
+static uint32_t get32(const uint8_t *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+static uint64_t get64(const uint8_t *p) { return get32(p) | (uint64_t)get32(p + 4) << 32; }
+static void send_raw(const void *b, size_t n) { if (write(g_cfd, b, n) != (ssize_t)n) { perror("write"); exit(2); } }
+static void send_msg(int type, const uint8_t *pl, size_t n) { uint8_t h[5]; put32(h, (uint32_t)n + 1); h[4] = (uint8_t)type; send_raw(h, 5); if (n) send_raw(pl, n); }
+static int read_fully(void *b, size_t n, int ms) {
+    uint8_t *p = b;
+    while (n) {
+        struct pollfd pf = {.fd = g_cfd, .events = POLLIN};
+        if (poll(&pf, 1, ms) <= 0) return 0;
+        ssize_t k = read(g_cfd, p, n); if (k <= 0) return 0;
+        p += k; n -= (size_t)k;
+    }
+    return 1;
+}
+// One message from the tap: its type, payload in buf (cap bytes), the payload length in *n; 0 when none arrives within ms
+static int recv_msg(uint8_t *buf, size_t cap, size_t *n, int ms) {
+    uint8_t h[5]; if (!read_fully(h, 5, ms)) return 0;
+    uint32_t len = get32(h); if (len < 1 || len - 1 > cap) return 0;
+    if (!read_fully(buf, len - 1, ms)) return 0;
+    *n = len - 1; return h[4];
+}
+static void connect_tap(void) {   // listener up, stream_start, accept
+    listen_on(); setenv("DM_STREAM", g_path, 1);
+    CHECK(stream_start("0400486024DEC000", "Test") == 0, "stream_start connects");
+    g_cfd = accept(g_lfd, NULL, NULL); if (g_cfd < 0) { perror("accept"); exit(2); }
+}
+static void drop_tap(void) { if (g_cfd >= 0) close(g_cfd); g_cfd = -1; if (g_lfd >= 0) close(g_lfd); g_lfd = -1; unlink(g_path); }
+
+static int16_t blk[240 * 8];
+static void fill(int ch, int16_t v) { for (int i = 0; i < 240 * ch; i++) blk[i] = v; }
+// An audio message must arrive; its pcm is checked to be 240 stereo frames all equal to want (-1: just count)
+static int audio_is(int want) {
+    uint8_t m[4096]; size_t n; int t = recv_msg(m, sizeof m, &n, 1000);
+    if (t != 3 || n != 9 + 240 * 4 || m[8] != 2) return 0;
+    const int16_t *s = (const int16_t *)(m + 9);
+    for (int i = 0; i < 480; i++) if (s[i] != want) return 0;
+    return 1;
+}
+static int no_message(void) { uint8_t h[5]; return !read_fully(h, 5, 60); }   // nothing at all arrives within 60 ms (a message of any size counts)
+
+int main(void) {
+    snprintf(g_dir, sizeof g_dir, "/tmp/t_stream.XXXXXX");
