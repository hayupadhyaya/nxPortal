+    fill(2, 1000); stream_audio_pcm(blk, 240 * 2 * 2, 2, 0, &a1);
+    CHECK(audio_is(3000), "the clock's next push carries the queued block: 1000 + 2000");
+    fill(2, 1000); stream_audio_pcm(blk, 240 * 2 * 2, 2, 0, &a1);
+    CHECK(audio_is(1000), "the queued block is used once");
