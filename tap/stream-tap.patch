+      fill(2, 2000); stream_audio_pcm_at(blk, 240 * 2 * 2, 2, 0, &cb, T - 1000000);
+      CHECK(no_message(), "a push stamped 1 ms before the clock's last makes no message");
+      fill(2, 1000); stream_audio_pcm_at(blk, 240 * 2 * 2, 2, 0, &ca, T + 5000000);
+      CHECK(audio_is(3000), "A is still the clock: one message with B's block");
+      CHECK(no_message(), "and only one"); }
+
+    // (h) video
+    CHECK(g_sink != NULL, "the video sink is registered");
+    const uint8_t fr[5] = {1, 2, 3, 4, 5};
+    g_sink(fr, 5, 1, -1, 1280, 720, 123456789ull);
+    t = recv_msg(m, sizeof m, &n, 1000);
+    CHECK(t == 2 && n == 21 + 5 && get32(m) == 0 && get64(m + 4) == 123456789ull && get16(m + 12) == 1280 && get16(m + 14) == 720 && m[16] == 1 && get32(m + 17) == 0xffffffffu && !memcmp(m + 21, fr, 5), "video message: frame 0, time, size, key, token -1 (none), bytes");
