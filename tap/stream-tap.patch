+      stream_audio_pcm(blk, 240 * 6 * 2, 6, 0, &b1);
+      fill(2, 0); stream_audio_pcm(blk, 240 * 2 * 2, 2, 0, &a1);
+      uint8_t am[4096]; size_t an; int at = recv_msg(am, sizeof am, &an, 1000); const int16_t *s = (const int16_t *)(am + 9);
